<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Registrar usuario — MamaFlor</title>

  <style>
    :root{
      --bg:#0f1320;
      --panel:#ffffff;
      --muted:#6b7280;
      --brand:#16a34a;
      --brand-2:#22c55e;
      --stroke:rgba(0,0,0,.12);
      --ring:rgba(34,197,94,.35);
      --shadow:0 10px 30px rgba(0,0,0,.25);
      --radius:18px; 
      --radius-sm:12px; 
      --maxw:1100px;
    }

    *,*::before,*::after{box-sizing:border-box}
    html,body{height:100%}

    /* Fondo dinámico */
    body{
      margin:0;
      font-family: ui-sans-serif, system-ui;
      background: radial-gradient(1200px 800px at 10% 10%, #111936 0%, transparent 60%),
                  radial-gradient(900px 700px at 90% 20%, #0c1024 0%, transparent 60%),
                  var(--bg);
      color:#0b1020;
      line-height:1.5;
      animation:bgMove 20s ease-in-out infinite;
    }

    @keyframes bgMove{
      0%{background-position:0 0}
      50%{background-position:30px 40px}
      100%{background-position:0 0}
    }

    body.parallax{
      background-position:
        calc(var(--x)/60) calc(var(--y)/60),
        calc(var(--x)/80) calc(var(--y)/80),
        var(--bg);
    }

    .container{
      max-width:var(--maxw);
      margin-inline:auto;
      padding:24px;
      animation:fadeUp .8s ease;
    }

    @keyframes fadeUp{
      from{opacity:0; transform:translateY(40px)}
      to{opacity:1; transform:translateY(0)}
    }

    /* Header */
    header{
      position:sticky; top:0; z-index:50;
      background:rgba(255,255,255,.85);
      backdrop-filter:blur(10px);
      border-bottom:1px solid var(--stroke);
    }

    .topbar{
      display:flex; align-items:center; justify-content:space-between;
      padding:10px 0;
    }

    .brand{display:flex; align-items:center; gap:12px; font-weight:900}
    .logo{
      width:38px;height:38px;border-radius:12px;
      display:grid;place-items:center;
      background:linear-gradient(135deg,var(--brand),var(--brand-2));
      color:white;font-weight:900;
      transition:.25s ease;
      box-shadow:0 4px 15px rgba(34,197,94,.55);
    }

    .logo:hover{
      transform:rotate(6deg) scale(1.12);
      box-shadow:0 8px 25px rgba(34,197,94,.75);
    }

    nav ul{display:flex; gap:10px; margin:0; padding:0; list-style:none}
    nav a{
      padding:10px 14px; border-radius:12px;
      font-weight:800;
      border:1px solid transparent;
      transition:.25s ease;
    }
    nav a:hover{
      background:rgba(34,197,94,.15);
      border-color:var(--ring);
      transform:translateY(-2px);
    }

    /* Card */
    .shell{width:min(720px,96vw); margin-inline:auto; margin-top:18px}
    .card{
      background:white;
      border-radius:var(--radius);
      border:1px solid var(--stroke);
      box-shadow:var(--shadow);
      animation:floatCard 4.5s ease-in-out infinite;
    }
    @keyframes floatCard{
      0%,100%{transform:translateY(0)}
      50%{transform:translateY(-6px)}
    }

    .card-content{padding:26px}

    h1{font-size:clamp(1.6rem,2.4vw+1rem,2.2rem); margin:0 0 .6rem}

    p.lead{color:var(--muted)}

    /* Campos */
    form{display:grid; gap:16px}
    .grid{display:grid; grid-template-columns:1fr 1fr; gap:14px}
    .field{display:grid; gap:8px}
    label{font-weight:800}

    .control{
      display:flex; align-items:center; gap:8px;
      background:white; border-radius:14px;
      padding:10px 12px;
      border:1px solid var(--stroke);
      transition:.25s ease;
    }

    .control:focus-within{
      border-color:var(--brand);
      box-shadow:0 0 14px rgba(34,197,94,.5);
      transform:scale(1.03);
    }

    input,select{
      border:none; outline:none; background:none;
      flex:1; font-size:1rem;
    }

    /* Indicador contraseña */
    .meter{
      height:8px; background:#eef1f3;
      border-radius:999px; overflow:hidden;
    }
    .meter > i{
      display:block; height:100%; width:0%;
      background:linear-gradient(90deg,#ef4444,#f59e0b,#22c55e);
      transition:width .25s ease;
    }

    /* Botones */
    .actions{
      display:flex; justify-content:space-between;
      align-items:center; flex-wrap:wrap;
    }

    .btn{
      padding:11px 16px; border-radius:14px;
      font-weight:800; cursor:pointer;
      background:white; border:1px solid var(--stroke);
      transition:.25s ease;
    }
    .btn:hover{
      transform:translateY(-3px);
      box-shadow:0 10px 22px rgba(34,197,94,.25);
    }

    .btn.primary{
      background:linear-gradient(135deg,var(--brand),var(--brand-2));
      color:white; border:none;
      box-shadow:0 6px 18px rgba(34,197,94,.35);
    }
    .btn.primary:hover{
      box-shadow:0 10px 26px rgba(34,197,94,.55),
                 0 0 18px rgba(34,197,94,.5);
      transform:translateY(-3px) scale(1.02);
    }

    /* Shake */
    @keyframes shake{
      0%{transform:translateX(0)}
      25%{transform:translateX(-6px)}
      50%{transform:translateX(6px)}
      75%{transform:translateX(-3px)}
      100%{transform:translateX(0)}
    }

    footer{text-align:center; margin-top:16px}
    .small{color:#e5e7eb}
  </style>
</head>
<body>

  <header>
    <div class="container topbar">
      <div class="brand">
        <div class="logo">MF</div>
        MamaFlor
      </div>
      <nav>
        <ul>
          <li><a href="index.html">Inicio</a></li>
          <li><a href="menu.html">Menú</a></li>
          <li><a href="pedido.html">Hacer pedido</a></li>
          <li><a href="pedidos.html">Pedidos</a></li>
          <li><a href="login.html">Iniciar sesión</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main class="container shell">
    <section class="card">
      <div class="card-content">

        <h1>Registrar usuario</h1>
        <p class="lead">Crea tu cuenta y comienza a realizar pedidos fácilmente.</p>

        <form id="regForm">

          <div class="grid">
            <!-- Nombre -->
            <div class="field">
              <label>Nombre completo *</label>
              <div class="control">
                <input id="nombre" required placeholder="Nombres y apellidos">
              </div>
            </div>

            <!-- Usuario -->
            <div class="field">
              <label>Usuario *</label>
              <div class="control">
                <input id="usuario" required placeholder="ej. mfigueroa">
              </div>
            </div>

            <!-- Correo -->
            <div class="field">
              <label>Correo *</label>
              <div class="control">
                <input id="correo" type="email" required placeholder="correo@dominio.com">
              </div>
            </div>

            <!-- Género -->
            <div class="field">
              <label>Género</label>
              <div class="control">
                <select id="genero">
                  <option value="">Seleccionar...</option>
                  <option>Femenino</option>
                  <option>Masculino</option>
                  <option>Prefiero no decirlo</option>
                </select>
              </div>
            </div>

            <!-- Contraseña -->
            <div class="field">
              <label>Contraseña *</label>
              <div class="control">
                <input id="pass1" type="password" required placeholder="********" oninput="passwordMeter()">
                <button type="button" onclick="togglePass('pass1')">👁️</button>
              </div>

              <div class="meter"><i id="meterbar"></i></div>
              <p id="metertext" class="muted">Fortaleza: —</p>
            </div>

            <!-- Confirmar -->
            <div class="field">
              <label>Confirmar contraseña *</label>
              <div class="control">
                <input id="pass2" type="password" required placeholder="Repetir contraseña">
                <button type="button" onclick="togglePass('pass2')">👁️</button>
              </div>
            </div>
          </div>

          <label style="margin-top:8px; display:flex; align-items:center; gap:8px">
            <input type="checkbox" id="tyc" required> Acepto los términos *
          </label>

          <div class="actions">
            <button class="btn primary" type="submit">Crear cuenta</button>
            <div class="links">
              <a href="login.html">← Iniciar sesión</a>
              <a href="index.html">Ir al inicio</a>
            </div>
          </div>
        </form>
      </div>
    </section>

    <footer>
      <p class="small">© 2025 MamaFlor</p>
    </footer>
  </main>

  <script>

    /* -------------------- PARALLAX -------------------- */
    document.addEventListener("mousemove", e =>{
      document.body.style.setProperty("--x", e.clientX);
      document.body.style.setProperty("--y", e.clientY);
      document.body.classList.add("parallax");

      clearTimeout(window.__px);
      window.__px = setTimeout(()=>document.body.classList.remove("parallax"), 90);
    });

    /* ------------------ TOGGLE PASSWORD ------------------ */
    function togglePass(id){
      const i = document.getElementById(id);
      i.type = (i.type === "password") ? "text" : "password";
    }

    /* ---------- MEDIDOR DE CONTRASEÑA PRO (DINÁMICO) --------- */
    function passwordMeter(){
      const v = document.getElementById("pass1").value;
      let score = 0;

      if(v.length >= 8) score++;
      if(/[A-Z]/.test(v)) score++;
      if(/[a-z]/.test(v)) score++;
      if(/[0-9]/.test(v)) score++;
      if(/[^A-Za-z0-9]/.test(v)) score++;

      const pct = (score/5) * 100;
      document.getElementById("meterbar").style.width = pct + "%";

      const labels = ["Muy débil", "Débil", "Aceptable", "Fuerte", "Muy fuerte"];
      document.getElementById("metertext").textContent = score ? "Fortaleza: " + labels[score-1] : "Fortaleza: —";
    }

    /* ------------------ VALIDACIÓN AVANZADA ------------------ */
    document.getElementById("regForm").addEventListener("submit", function(e){
      e.preventDefault();

      const req = ["nombre","usuario","correo","pass1","pass2"];
      for(const id of req){
        const el = document.getElementById(id);
        if(!el.value.trim()){
          shake(el.parentElement);
          alert("Completa: " + id);
          el.focus();
          return;
        }
      }

      if(!tyc.checked){
        shake(document.getElementById("tyc"));
        alert("Debes aceptar los términos.");
        return;
      }

      if(pass1.value !== pass2.value){
        shake(document.getElementById("pass2").parentElement);
        alert("Las contraseñas no coinciden.");
        return;
      }

      alert("¡Usuario registrado correctamente!");
    });

    /* -------------------- EFECTO SHAKE -------------------- */
    function shake(element){
      element.style.animation = "shake .35s";
      setTimeout(() => element.style.animation = "", 400);
    }

  </script>
</body>
</html>

