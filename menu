  <!-- ------------------------- JS PROFESIONAL ------------------------- -->
  <script>
    /* ---------------- FILTRO CON ANIMACIÓN ---------------- */
    function filterRows(q){
      q = (q||'').toLowerCase().normalize('NFD').replace(/\p{Diacritic}/gu,'');

      let found = false;
      document.querySelectorAll("tbody tr").forEach(tr=>{
        const text = tr.innerText.toLowerCase().normalize('NFD').replace(/\p{Diacritic}/gu,'');
        const show = text.includes(q);
        tr.style.display = show ? "" : "none";
        if(show) found = true;
      });

      if(!found){
        animateShake(document.querySelector(".menu"));
      }
    }

    /* Animación de temblor */
    function animateShake(el){
      el.style.animation = "shake .4s ease";
      setTimeout(() => el.style.animation = "", 400);
    }

    /* Keyframes del shake */
    const styleShake = document.createElement("style");
    styleShake.textContent = `
      @keyframes shake{
        0%{transform:translateX(0)}
        25%{transform:translateX(-6px)}
        50%{transform:translateX(6px)}
        75%{transform:translateX(-4px)}
        100%{transform:translateX(0)}
      }
    `;
    document.head.appendChild(styleShake);


    /* ---------------- FONDO PARALLAX ---------------- */
    document.addEventListener("mousemove", e=>{
      document.body.style.setProperty("--x", e.clientX);
      document.body.style.setProperty("--y", e.clientY);
      document.body.classList.add("parallax-moving");

      clearTimeout(window.__bg);
      window.__bg = setTimeout(()=>{
        document.body.classList.remove("parallax-moving");
      },120);
    });

  </script>

