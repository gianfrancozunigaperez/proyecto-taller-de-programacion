<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Menú — MamaFlor</title>

  <style>
    :root{
      --bg:#0f1320;
      --panel:#ffffff;
      --muted:#6b7280;
      --brand:#16a34a;
      --brand-2:#22c55e;
      --stroke:rgba(0,0,0,.12);
      --ring:rgba(34,197,94,.28);
      --shadow:0 10px 30px rgba(0,0,0,.25);
      --radius:18px;
    }

    *,*::before,*::after{box-sizing:border-box}
    html,body{height:100%}

    /* ------------------------- FONDO ANIMADO ------------------------- */
    body{
      margin:0;
      font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI;
      background: radial-gradient(1200px 800px at 10% 10%, #111936 0%, transparent 60%),
                  radial-gradient(1000px 800px at 90% 20%, #0c1024 0%, transparent 60%),
                  var(--bg);
      color:#0b1020;
      line-height:1.55;
      animation: subtleMove 22s ease-in-out infinite;
      transition:background-position .05s ease-out;
    }

    body.parallax-moving{
      background-position: calc(var(--x)/70) calc(var(--y)/70);
    }

    @keyframes subtleMove{
      0%{background-position:0 0}
      50%{background-position:18px 25px}
      100%{background-position:0 0}
    }

    a{text-decoration:none; color:inherit}

    /* ------------------------- CONTENEDOR ---------------------------- */
    .container{
      max-width:1100px;
      margin:auto;
      padding:24px;
      animation: fadeUp .8s ease;
    }

    @keyframes fadeUp{
      from{opacity:0; transform:translateY(40px)}
      to{opacity:1; transform:translateY(0)}
    }

    /* ------------------------- HEADER ------------------------------- */
    header{
      position:sticky; top:0; z-index:50;
      backdrop-filter:saturate(180%) blur(8px);
      background:linear-gradient(180deg,#ffffffc8,#ffffffa8);
      border-bottom:1px solid var(--stroke);
      animation: smoothFade 1s ease;
    }

    @keyframes smoothFade{
      from{opacity:0} to{opacity:1}
    }

    .topbar{
      display:flex; justify-content:space-between; align-items:center;
    }

    .brand{
      display:flex; align-items:center; gap:12px; font-weight:800;
      animation: fadeUp 1s ease;
    }

    .logo{
      width:38px; height:38px; border-radius:12px;
      background:linear-gradient(135deg,var(--brand),var(--brand-2));
      color:white; font-weight:900; display:grid; place-items:center;
      box-shadow:0 4px 15px rgba(34,197,94,.4);
    }

    nav ul{
      list-style:none; display:flex; gap:8px; padding:0; margin:0;
    }

    nav a{
      padding:10px 14px; font-weight:700;
      border-radius:12px; transition:.25s ease;
      border:1px solid transparent;
    }
    nav a:hover{
      background:rgba(34,197,94,.12);
      border-color:var(--ring);
      transform:translateY(-3px);
    }

    /* ---------------------- CABECERA DEL MENÚ ------------------------- */
    .headline{
      margin-top:20px;
      display:flex; justify-content:space-between; gap:12px; align-items:flex-end;
      animation: fadeUp 1s ease;
    }

    .kicker{
      color:var(--brand); font-weight:900; text-transform:uppercase;
    }

    h1{margin:6px 0 0; font-size:clamp(1.6rem, 2.4vw + 1rem, 2.2rem)}

    .lead{color:var(--muted)}

    /* ------------------------- BUSCADOR ------------------------------ */
    .filters{
      display:flex; gap:10px;
    }

    .input{
      display:flex; align-items:center; gap:8px;
      background:white; padding:10px 12px;
      border-radius:14px;
      border:1px solid var(--stroke);
      transition:all .3s ease;
    }

    .input:hover{
      transform:scale(1.03);
      box-shadow:0 0 18px rgba(34,197,94,.28);
    }

    .input input{
      border:none; outline:none; font-size:1rem; min-width:220px;
    }

    /* -------------------------- TARJETAS ----------------------------- */
    section.menu{
      margin-top:22px; display:grid; gap:22px;
      animation: fadeUp 1.2s ease;
    }

    .card{
      background:white; border-radius:var(--radius);
      box-shadow:var(--shadow);
      border:1px solid var(--stroke);
      animation: floatCard 4s ease-in-out infinite;
    }

    @keyframes floatCard{
      0%,100%{transform:translateY(0)}
      50%{transform:translateY(-4px)}
    }

    .card-header{
      padding:18px 22px; font-size:1.25rem;
      border-bottom:1px solid var(--stroke);
      display:flex; justify-content:space-between;
    }

    /* ------------------------- TABLA ------------------------------- */
    table{
      width:100%; border-collapse:separate;
      border-spacing:0; font-size:1rem;
    }

    thead th{
      position:sticky; top:0;
      background:#fafafa; font-weight:900;
      border-bottom:1px solid var(--stroke);
      padding:12px 14px;
    }

    tbody tr td{
      padding:12px 14px;
      transition:.25s ease;
    }

    tbody tr:not(:last-child) td{
      border-bottom:1px dashed var(--stroke);
    }

    tbody tr:hover td{
      background:rgba(34,197,94,.06);
      transform:scale(1.018);
    }

    .price{font-weight:800}

    .add a{
      padding:8px 12px;
      background:white;
      border:1px solid var(--stroke);
      border-radius:12px;
      display:inline-flex; align-items:center;
      gap:6px; font-weight:700;
      transition:.25s ease;
    }

    /* Glow verde añadir */
    .add a:hover{
      transform:translateY(-4px) scale(1.08);
      box-shadow:
        0 12px 26px rgba(34,197,94,.28),
        0 0 22px rgba(34,197,94,.26);
    }

    footer{margin-top:24px}
    .footer-card{
      display:flex; justify-content:space-between; padding:18px; gap:12px;
    }

    .small{color:var(--muted)}


  </style>
</head>

