<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Formulario de Pedido — MamaFlor</title>

  <style>
    :root{
      --bg:#0f1320;
      --panel:#ffffff;
      --muted:#6b7280;
      --brand:#16a34a;
      --brand-2:#22c55e;
      --stroke:rgba(0,0,0,.12);
      --ring:rgba(34,197,94,.28);
      --shadow:0 10px 30px rgba(0,0,0,.25);
      --radius:18px;
      --radius-sm:12px;
      --maxw:1100px;
    }

    *,*::before,*::after{box-sizing:border-box}
    html,body{height:100%}

    /* ---------------------- Fondo animado ---------------------- */
    body{
      margin:0;
      font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI;
      background: radial-gradient(1200px 800px at 10% 10%, #111936 0%, transparent 60%),
                  radial-gradient(1000px 800px at 90% 20%, #0c1024 0%, transparent 60%),
                  var(--bg);
      color:#0b1020;
      line-height:1.55;
      animation: subtleMove 22s ease-in-out infinite;
      transition: background-position .05s ease-out;
    }

    body.parallax{
      background-position: calc(var(--x)/60) calc(var(--y)/60);
    }

    @keyframes subtleMove{
      0%{background-position:0 0}
      50%{background-position:20px 25px}
      100%{background-position:0 0}
    }

    .container{
      max-width:var(--maxw);
      margin-inline:auto;
      padding:24px;
      animation: fadeUp .9s ease;
    }

    @keyframes fadeUp{
      from{opacity:0; transform:translateY(40px)}
      to{opacity:1; transform:translateY(0)}
    }

    /* ---------------------- Header ---------------------- */
    header{
      position:sticky; top:0; z-index:50;
      backdrop-filter: blur(8px);
      background:rgba(255,255,255,.75);
      border-bottom:1px solid var(--stroke);
      animation: fadeIn .7s ease;
    }
    @keyframes fadeIn{from{opacity:0}to{opacity:1}}

    .topbar{display:flex; align-items:center; justify-content:space-between}
    .brand{display:flex; align-items:center; gap:12px; font-weight:900}
    .logo{
      width:38px;height:38px;border-radius:12px;
      display:grid;place-items:center;
      background:linear-gradient(135deg,var(--brand),var(--brand-2));
      color:white;font-weight:900;
      box-shadow:0 4px 14px rgba(34,197,94,.4);
    }

    nav ul{display:flex; gap:8px; padding:0; margin:0; list-style:none}
    nav a{
      padding:10px 14px; border-radius:12px; font-weight:700;
      border:1px solid transparent; transition:.25s ease;
    }
    nav a:hover{
      background:rgba(34,197,94,.15);
      border-color:var(--ring);
      transform:translateY(-2px);
    }

    /* --------------------- Tarjetas --------------------- */
    .grid{
      display:grid; grid-template-columns:1fr 1fr;
      gap:20px; margin-top:20px;
      animation: fadeUp .9s ease;
    }

    .card{
      background:white; border-radius:var(--radius);
      box-shadow:var(--shadow); border:1px solid var(--stroke);
      animation: floatCard 3.8s ease-in-out infinite;
    }
    @keyframes floatCard{
      0%,100%{transform:translateY(0)}
      50%{transform:translateY(-5px)}
    }

    .card-header{
      padding:18px 22px;
      border-bottom:1px solid var(--stroke);
      font-size:1.25rem;
      font-weight:800;
    }

    .card-content{padding:20px}

    /* --------------------- Campos --------------------- */
    .control{
      display:flex; align-items:center; padding:10px 12px;
      background:white; border-radius:14px; border:1px solid var(--stroke);
      transition:.25s ease;
    }

    .control:focus-within{
      border-color:var(--brand);
      box-shadow:0 0 14px rgba(34,197,94,.35);
      transform:scale(1.02);
    }

    input{
      border:none; outline:none; background:none; flex:1;
      font-size:1rem;
    }

    /* ------------------- Filas de platos ------------------- */
    .row{
      display:flex; justify-content:space-between; align-items:center;
      background:white; padding:10px 12px;
      border:1px solid var(--stroke);
      border-radius:14px; transition:.25s ease;
    }

    .row:hover{
      transform:scale(1.02);
      box-shadow:0 10px 20px rgba(34,197,94,.20);
      border-color:var(--brand-2);
    }

    .row input[type="checkbox"]{
      width:20px;height:20px;cursor:pointer;
      accent-color:var(--brand);
      transition:.25s;
    }

    .row input:checked{
      filter:drop-shadow(0 0 6px var(--brand-2));
      transform:scale(1.25);
    }

    /* --------------------- Botones ---------------------- */
    .btn{
      padding:12px 16px; border-radius:14px; font-weight:800;
      background:white; border:1px solid var(--stroke); cursor:pointer;
      transition:all .25s ease;
    }
    .btn:hover{
      transform:translateY(-3px);
      box-shadow:0 8px 22px rgba(34,197,94,.3);
    }

    .btn.primary{
      background:linear-gradient(135deg,var(--brand),var(--brand-2));
      color:white; border:none;
      box-shadow:0 6px 18px rgba(34,197,94,.3);
    }
    .btn.primary:hover{
      box-shadow:0 10px 26px rgba(34,197,94,.45),
                 0 0 18px rgba(34,197,94,.4);
      transform:translateY(-3px) scale(1.03);
    }

    /* --------------------- Resumen ------------------------ */
    #total{
      transition:.25s ease;
    }

    /* Vibración */
    @keyframes shake{
      0%{transform:translateX(0)}
      25%{transform:translateX(-6px)}
      50%{transform:translateX(6px)}
      75%{transform:translateX(-3px)}
      100%{transform:translateX(0)}
    }

    /* Responsive */
    @media(max-width:900px){
      .grid{grid-template-columns:1fr}
    }
  </style>
</head>

<body>

  <header>
    <div class="container topbar">
      <div class="brand"><div class="logo">MF</div> MamaFlor</div>
      <nav>
        <ul>
          <li><a href="index.html">Inicio</a></li>
          <li><a href="menu.html">Menú</a></li>
          <li><a href="pedidos.html">Pedidos</a></li>
          <li><a href="login.html">Iniciar sesión</a></li>
          <li><a href="registrar.html">Registrar</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main class="container">
    <div class="kicker" style="color:var(--brand);font-weight:900;">Pedido</div>
    <h1>Formulario de Pedido</h1>
    <p class="muted">Completa tus datos y selecciona los platos.</p>

    <!-- ------------------ FORMULARIO ------------------ -->
    <form id="pedidoForm" onsubmit="submitOrder(event)">
      <div class="grid">

        <!-- DATOS DEL CLIENTE -->
        <section class="card">
          <div class="card-header">Datos del cliente</div>
          <div class="card-content">
            <div class="field">
              <label>Nombre</label>
              <div class="control"><input id="cliente" required></div>
            </div>
            <div class="field">
              <label>Dirección</label>
              <div class="control"><input id="direccion" required></div>
            </div>
            <div class="field">
              <label>Teléfono</label>
              <div class="control"><input id="telefono" required></div>
            </div>
          </div>
        </section>

        <!-- PLATOS -->
        <section class="card">
          <div class="card-header">Selección de platos</div>
          <div class="card-content">

            <h3>Desayuno</h3>
              <label class="row">
                <span class="row-left"><input type="checkbox" name="platos" value="Tamales" data-price="10.90"> Tamales</span>
                <span class="price">S/ 10.90</span>
              </label>
              <label class="row">
                <span class="row-left"><input type="checkbox" name="platos" value="Pan con chicharrón" data-price="10.90"> Pan con chicharrón</span>
                <span class="price">S/ 10.90</span>
              </label>
              <label class="row">
                <span class="row-left"><input type="checkbox" name="platos" value="Queso frito" data-price="7.90"> Queso frito</span>
                <span class="price">S/ 7.90</span>
              </label>
              <label class="row">
                <span class="row-left"><input type="checkbox" name="platos" value="Pan con pollo" data-price="4.90"> Pan con pollo</span>
                <span class="price">S/ 4.90</span>
              </label>
              <label class="row">
                <span class="row-left"><input type="checkbox" name="platos" value="Pan con pejerrey" data-price="5.90"> Pan con pejerrey</span>
                <span class="price">S/ 5.90</span>
              </label>
              <label class="row">
                <span class="row-left"><input type="checkbox" name="platos" value="Panqueques" data-price="3.90"> Panqueques</span>
                <span class="price">S/ 3.90</span>
              </label>

            <h3>Almuerzo</h3>
              <label class="row">
                <span class="row-left"><input type="checkbox" name="platos" value="Arroz con pato" data-price="19.90"> Arroz con pato</span>
                <span class="price">S/ 19.90</span>
              </label>
              <label class="row">
                <span class="row-left"><input type="checkbox" name="platos" value="Seco de pato" data-price="21.90"> Seco de pato</span>
                <span class="price">S/ 21.90</span>
              </label>
              <label class="row">
                <span class="row-left"><input type="checkbox" name="platos" value="Sopa seca" data-price="24.90"> Sopa seca</span>
                <span class="price">S/ 24.90</span>
              </label>
              <label class="row">
                <span class="row-left"><input type="checkbox" name="platos" value="Carapulcra" data-price="17.90"> Carapulcra</span>
                <span class="price">S/ 17.90</span>
              </label>
              <label class="row">
                <span class="row-left"><input type="checkbox" name="platos" value="Trucha frita" data-price="29.90"> Trucha frita</span>
                <span class="price">S/ 29.90</span>
              </label>
              <label class="row">
                <span class="row-left"><input type="checkbox" name="platos" value="Lomo saltado" data-price="24.90"> Lomo saltado</span>
                <span class="price">S/ 24.90</span>
              </label>

            <h3>Cena</h3>
              <label class="row">
                <span class="row-left"><input type="checkbox" name="platos" value="Anticucho" data-price="19.90"> Anticucho</span>
                <span class="price">S/ 19.90</span>
              </label>
              <label class="row">
                <span class="row-left"><input type="checkbox" name="platos" value="Chicharrón" data-price="24.90"> Chicharrón</span>
                <span class="price">S/ 24.90</span>
              </label>
              <label class="row">
                <span class="row-left"><input type="checkbox" name="platos" value="Pollo a la brasa" data-price="19.90"> Pollo a la brasa</span>
                <span class="price">S/ 19.90</span>
              </label>
              <label class="row">
                <span class="row-left"><input type="checkbox" name="platos" value="Pollo broaster" data-price="16.90"> Pollo broaster</span>
                <span class="price">S/ 16.90</span>
              </label>
              <label class="row">
                <span class="row-left"><input type="checkbox" name="platos" value="Chaufa" data-price="15.90"> Chaufa</span>
                <span class="price">S/ 15.90</span>
              </label>
              <label class="row">
                <span class="row-left"><input type="checkbox" name="platos" value="Pollo a la parrilla" data-price="21.90"> Pollo a la parrilla</span>
                <span class="price">S/ 21.90</span>
              </label>

            <div class="field">
              <label>Cantidad total</label>
              <div class="control"><input id="cantidad" type="number" min="1" value="1"></div>
            </div>

          </div>
        </section>

        <!-- RESUMEN -->
        <aside class="card">
          <div class="card-header">Resumen</div>
          <div class="card-content">
            <p><strong>Subtotal:</strong> <span id="subtotal">S/ 0.00</span></p>
            <p><strong>Total:</strong> <span id="total">S/ 0.00</span></p>

            <button class="btn primary" type="submit">Enviar Pedido</button>
          </div>
        </aside>

      </div>
    </form>

  </main>


  <!-- ------------------------- JS PROFESIONAL ------------------------- -->
  <script>

    /* ========= PARALLAX ========= */
    document.addEventListener("mousemove", e=>{
      document.body.style.setProperty("--x", e.clientX);
      document.body.style.setProperty("--y", e.clientY);
      document.body.classList.add("parallax");

      clearTimeout(window._p);
      window._p = setTimeout(()=>document.body.classList.remove("parallax"),120);
    });

    /* ========= CÁLCULO DEL TOTAL ========= */
    const fmt = n => "S/ " + n.toFixed(2);
    const subtotalEl = document.getElementById("subtotal");
    const totalEl = document.getElementById("total");
    const qtyEl = document.getElementById("cantidad");

    function calcTotal(){
      const qty = Math.max(1, parseInt(qtyEl.value || "1"));

      const selected = Array.from(document.querySelectorAll(".row input:checked"))
          .map(el => parseFloat(el.dataset.price));

      const subtotal = selected.reduce((a,b)=>a+b,0);
      const total = subtotal * qty;

      subtotalEl.textContent = fmt(subtotal);
      totalEl.textContent = fmt(total);

      // animación suave
      totalEl.style.transform = "scale(1.2)";
      totalEl.style.color = "var(--brand)";
      setTimeout(()=>{
        totalEl.style.transform = "scale(1)";
        totalEl.style.color = "";
      },200);
    }

    document.querySelectorAll(".row input").forEach(c=>c.addEventListener("change", calcTotal));
    qtyEl.addEventListener("input", calcTotal);
    window.addEventListener("DOMContentLoaded", calcTotal);

    /* ========= ENVÍO ========= */
    function submitOrder(e){
      e.preventDefault();

      const platos = Array.from(document.querySelectorAll(".row input:checked"));

      if(platos.length === 0){
        // vibración
        document.querySelector(".card-content").style.animation = "shake .4s ease";
        setTimeout(()=>{
          document.querySelector(".card-content").style.animation = "";
        },400);
        alert("Selecciona al menos un plato.");
        return;
      }

      alert("¡Pedido enviado correctamente!");
    }

  </script>

</body>
</html>
