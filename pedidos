<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Pedidos realizados — MamaFlor</title>

  <style>
    :root{
      --bg:#0f1320;
      --panel:#ffffff;
      --muted:#6b7280;
      --brand:#16a34a;
      --brand-2:#22c55e;
      --stroke:rgba(0,0,0,.12);
      --ring:rgba(34,197,94,.25);
      --shadow:0 10px 30px rgba(0,0,0,.25);
      --radius:18px;
      --radius-sm:12px;
      --maxw:1100px;
    }

    *,*::before,*::after{box-sizing:border-box}
    html,body{height:100%}

    /* Fondo dinámico */
    body{
      margin:0;
      font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto;
      background: radial-gradient(1200px 800px at 10% 10%, #111936 0%, transparent 60%),
                  radial-gradient(900px 700px at 90% 20%, #0c1024 0%, transparent 60%),
                  var(--bg);
      color:#0b1020;
      line-height:1.55;
      animation: bgMove 20s ease-in-out infinite;
    }

    @keyframes bgMove{
      0%{background-position:0 0}
      50%{background-position:20px 25px}
      100%{background-position:0 0}
    }

    body.parallax{
      background-position:
        calc(var(--x)/55) calc(var(--y)/55),
        calc(var(--x)/65) calc(var(--y)/65),
        var(--bg);
    }

    .container{
      max-width:var(--maxw);
      margin-inline:auto;
      padding:24px;
      animation: fadeUp .8s ease;
    }

    @keyframes fadeUp{
      from{opacity:0; transform:translateY(35px)}
      to{opacity:1; transform:translateY(0)}
    }

    /* Header */
    header{
      position:sticky; top:0; z-index:50;
      backdrop-filter: blur(10px);
      background:rgba(255,255,255,.86);
      border-bottom:1px solid var(--stroke);
    }

    .topbar{
      display:flex; align-items:center; justify-content:space-between;
      padding:10px 0;
    }

    .brand{
      display:flex; align-items:center; gap:12px;
      font-weight:900; font-size:1.1rem;
    }

    .logo{
      width:38px;height:38px;border-radius:12px;
      display:grid;place-items:center;
      background:linear-gradient(135deg,var(--brand),var(--brand-2));
      color:white;font-weight:900;
      box-shadow:0 4px 12px rgba(34,197,94,.55);
      transition:.3s;
    }

    .logo:hover{
      transform:rotate(6deg) scale(1.1);
      box-shadow:0 6px 20px rgba(34,197,94,.8);
    }

    nav ul{display:flex; gap:8px; margin:0; padding:0; list-style:none}
    nav a{
      padding:10px 14px; border-radius:12px;
      font-weight:700; border:1px solid transparent;
      transition:.25s ease;
    }
    nav a:hover{
      background:rgba(34,197,94,.15);
      border-color:var(--ring);
      transform:translateY(-2px);
    }

    /* Headline */
    .headline{
      margin:20px 0 6px;
      display:flex; justify-content:space-between;
      align-items:end;
    }

    h1{ margin:0; font-size:clamp(1.6rem,2.4vw+1rem,2.3rem) }
    .kicker{font-size:.75rem; color:var(--brand); font-weight:900; letter-spacing:.4px}
    .lead{color:var(--muted)}

    /* Filtros */
    .filters{
      display:flex; gap:10px; flex-wrap:wrap;
      align-items:center;
    }

    .input, .select{
      display:flex; align-items:center; gap:8px;
      padding:10px 12px;
      background:white; border-radius:14px;
      border:1px solid var(--stroke);
      transition:.25s;
    }
    .input:hover, .select:hover{
      box-shadow:0 4px 10px rgba(34,197,94,.22);
    }

    .input input, .select select{
      border:none; outline:none; background:none;
      font-size:1rem;
    }

    .btn{
      padding:10px 14px; border-radius:12px;
      font-weight:800; cursor:pointer;
      background:white; border:1px solid var(--stroke);
      transition:.25s ease;
    }
    .btn:hover{
      transform:translateY(-3px);
      box-shadow:0 10px 20px rgba(34,197,94,.25);
    }

    /* Tabla */
    .card{
      background:white; border-radius:var(--radius);
      box-shadow:var(--shadow);
      border:1px solid var(--stroke);
      animation: floatCard 4s ease-in-out infinite;
    }

    @keyframes floatCard{
      0%,100%{transform:translateY(0)}
      50%{transform:translateY(-4px)}
    }

    .table-wrap{overflow:auto}

    table{width:100%; border-collapse:separate; border-spacing:0; font-size:1rem}

    thead th{
      position:sticky; top:0;
      background:#f5f5f5;
      font-weight:900;
      border-bottom:1px solid var(--stroke);
    }

    tbody tr{transition:.25s ease}

    tbody tr:hover{
      background:rgba(34,197,94,.08);
      transform:scale(1.01);
    }

    /* Estados */
    .status{
      display:inline-flex; padding:6px 10px;
      border-radius:999px; font-weight:800;
      border:1px solid var(--stroke);
      transition:.25s;
    }

    .status[data-state="En Proceso"]{ background:rgba(34,197,94,.15) }
    .status[data-state="Preparando"]{ background:rgba(234,179,8,.15) }
    .status[data-state="Entregado"]{ background:rgba(37,99,235,.15) }
    .status[data-state="Cancelado"]{ background:rgba(239,68,68,.15) }

    .status:hover{
      transform:scale(1.1);
      box-shadow:0 4px 10px rgba(0,0,0,.25) inset;
    }

    /* Footer */
    footer{margin-top:24px}
    .footer-card{
      display:flex; justify-content:space-between;
      padding:18px; border-radius:var(--radius);
    }

    @media(max-width:900px){
      .headline{flex-direction:column; align-items:flex-start}
    }

  </style>
</head>
<body>

  <!-- HEADER -->
  <header>
    <div class="container topbar">
      <div class="brand">
        <div class="logo">MF</div>
        MamaFlor
      </div>
      <nav>
        <ul>
          <li><a href="index.html">Inicio</a></li>
          <li><a href="menu.html">Menú</a></li>
          <li><a href="pedido.html">Hacer pedido</a></li>
          <li><a href="login.html">Iniciar sesión</a></li>
          <li><a href="registrar.html">Registrar</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <!-- MAIN -->
  <main class="container">

    <div class="headline">
      <div>
        <div class="kicker">Pedidos</div>
        <h1>Pedidos realizados</h1>
        <p class="lead">Busca, filtra, ordena y gestiona visualmente los pedidos.</p>
      </div>

      <form class="filters" onsubmit="event.preventDefault()">
        <label class="input">
          🔍 <input id="q" type="search" placeholder="Buscar…" oninput="applyFilters()">
        </label>

        <label class="select">
          Estado:
          <select id="estado" onchange="applyFilters()">
            <option value="">Todos</option>
            <option>En Proceso</option>
            <option>Preparando</option>
            <option>Entregado</option>
            <option>Cancelado</option>
          </select>
        </label>

        <button class="btn" type="button" onclick="sortBy('num')">Ordenar Nº</button>
        <button class="btn" type="button" onclick="sortBy('total')">Ordenar Total</button>
      </form>
    </div>

    <!-- TABLA -->
    <section class="card">
      <div class="table-wrap">
        <table id="tabla">
          <thead>
            <tr>
              <th>N.º Pedido</th>
              <th>Cliente</th>
              <th>Platos</th>
              <th>Total</th>
              <th>Estado</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td data-num="202500001">PM-2025-00001</td>
              <td>Juan Pérez</td>
              <td>Sopa seca, Carapulcra</td>
              <td class="num" data-total="42.80">S/ 42.80</td>
              <td><span class="status" data-state="En Proceso">En Proceso</span></td>
            </tr>

            <tr>
              <td data-num="202500002">PM-2025-00002</td>
              <td>María López</td>
              <td>Tamales</td>
              <td class="num" data-total="10.90">S/ 10.90</td>
              <td><span class="status" data-state="Preparando">Preparando</span></td>
            </tr>

          </tbody>
        </table>
      </div>
    </section>

    <footer>
      <div class="card footer-card">
        <p class="small">Contacto: contacto@MamaFlor.com</p>
        <p class="small">© 2025 MamaFlor</p>
      </div>
    </footer>

  </main>


  <!-- JS PROFESIONAL -->
  <script>

    /* -------- PARALLAX -------- */
    document.addEventListener("mousemove", e =>{
      document.body.style.setProperty("--x", e.clientX);
      document.body.style.setProperty("--y", e.clientY);
      document.body.classList.add("parallax");

      clearTimeout(window.__px);
      window.__px = setTimeout(()=>document.body.classList.remove("parallax"), 100);
    });


    /* -------- NORMALIZAR -------- */
    function normalize(str){
      return (str || "").toLowerCase()
        .normalize("NFD")
        .replace(/\p{Diacritic}/gu, "");
    }

    /* -------- FILTRO -------- */
    function applyFilters(){
      const q = normalize(document.getElementById("q").value);
      const est = document.getElementById("estado").value;
      const rows = document.querySelectorAll("#tabla tbody tr");

      rows.forEach(tr =>{
        const text = normalize(tr.innerText);
        const estadoFila = tr.querySelector(".status")?.dataset.state || "";

        const condTexto = text.includes(q);
        const condEstado = !est || est === estadoFila;

        tr.style.display = (condTexto && condEstado) ? "" : "none";
      });
    }


    /* -------- ORDENAMIENTO -------- */
    let sortAsc = {num:true, total:true};

    function sortBy(key){
      const tbody = document.querySelector("#tabla tbody");
      const rows = Array.from(tbody.querySelectorAll("tr"));
      const dir = sortAsc[key] ? 1 : -1;

      rows.sort((a,b)=>{
        const va = parseFloat(a.querySelector(`[data-${key}]`).dataset[key]);
        const vb = parseFloat(b.querySelector(`[data-${key}]`).dataset[key]);
        return (va > vb ? 1 : -1) * dir;
      });

      rows.forEach(r => tbody.appendChild(r));
      sortAsc[key] = !sortAsc[key];
    }

  </script>

</body>
</html>
